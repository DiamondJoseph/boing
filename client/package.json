{
  "name": "boing client",
  "version": "1.0.0",
  "main": "index.js",
  "author": "DiamondJoseph",
  "license": "0BSD",
  "type": "module",
  "scripts": {
    "prebuild": "node -p \"'console.log(' + JSON.stringify(require('./package.json').version) + ');'\" > src/version.ts",
    "build": "tsc --noEmit && node build.mjs",
    "generate:api": "openapi-typescript ../server/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
